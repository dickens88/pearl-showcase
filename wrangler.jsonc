{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pearl-showcase",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "alsgvip.com", "custom_domain": true },
    { "pattern": "www.alsgvip.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pearl-showcase",
      "database_id": "b1f6f862-c69f-43b7-8425-8f8b4a85e085",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "pearl-showcase-uploads"
    }
  ],
  "observability": { "enabled": true }
}
